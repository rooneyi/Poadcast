{% extends 'base.html.twig' %}

{% block title %}Podcasts - Parcours{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-12 px-6 lg:px-8">
        <div class="flex items-center justify-between mb-12">
            <div>
                <h1 class="text-4xl font-black text-gray-900 dark:text-white tracking-tight">Tous les podcasts</h1>
                <p class="text-lg text-gray-600 dark:text-gray-400 mt-2">Dernières publications de la communauté.</p>
            </div>
            <a href="{{ path('app_podcast_new') }}" class="inline-flex items-center gap-x-2 rounded-full bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-lg hover:bg-indigo-500 transition-all">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Publier un podcast
            </a>
        </div>

        {% if podcasts|length > 0 %}
            <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
                {% for podcast in podcasts %}
                <div class="group relative flex flex-col bg-gray-50/50 dark:bg-gray-900/50 rounded-3xl p-4 transition-all hover:bg-white hover:shadow-2xl dark:hover:bg-gray-900 border border-transparent hover:border-gray-100 dark:hover:border-gray-800">
                    <div class="aspect-square overflow-hidden rounded-2xl mb-6 relative">
                        {% if podcast.coverImage %}
                            <img src="{{ asset('uploads/podcasts/images/' ~ podcast.coverImage) }}" 
                                 alt="{{ podcast.title }}" 
                                 class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-500">
                        {% else %}
                             <div class="h-full w-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                                <svg class="h-16 w-16 text-indigo-400 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                                </svg>
                             </div>
                        {% endif %}
                        <div class="absolute inset-x-0 bottom-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                             <a href="{{ path('app_podcast_show', {'id': podcast.id}) }}" class="bg-indigo-600 block text-center rounded-xl p-3 text-white font-bold text-sm shadow-xl">ÉCOUTER</a>
                        </div>
                    </div>
                    <div class="flex flex-col flex-1">
                        <div class="flex items-center gap-x-2 text-xs font-bold text-indigo-600 uppercase tracking-wider mb-2">
                             <span>{{ podcast.author ?: 'Anonyme' }}</span>
                             {% if podcast.duration %}
                                <span class="text-gray-300 dark:text-gray-700 mx-1">•</span>
                                <span class="text-gray-500 dark:text-gray-400 font-normal lowercase">{{ podcast.duration }}</span>
                             {% endif %}
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 leading-tight group-hover:text-indigo-600 transition-colors">
                            {{ podcast.title }}
                        </h3>
                    </div>
                    <a href="{{ path('app_podcast_show', {'id': podcast.id}) }}" class="absolute inset-0 z-0"></a>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-24 bg-gray-50 dark:bg-gray-900/50 rounded-3xl border border-dashed border-gray-200 dark:border-gray-800">
                 <div class="bg-white dark:bg-gray-900 rounded-2xl w-24 h-24 mx-auto flex items-center justify-center mb-6 shadow-sm border border-gray-100 dark:border-gray-800">
                      <svg class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l-3 3 3 3m10.5-3l3-3-3-3" />
                      </svg>
                 </div>
                 <h2 class="text-2xl font-bold dark:text-white">Aucun podcast pour le moment</h2>
                 <p class="text-gray-600 dark:text-gray-400 mt-2 max-w-sm mx-auto">Soyez le premier à partager une histoire avec le monde en publiant votre propre contenu.</p>
                 <a href="{{ path('app_podcast_new') }}" class="inline-block mt-8 rounded-full bg-indigo-600 px-8 py-3 text-sm font-bold text-white shadow-xl hover:bg-indigo-500 transition-all">Publier un podcast</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
