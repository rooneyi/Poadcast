    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <section class="flex min-h-screen">
        <form action="" class="card bg-ui tls-shadow-md m-auto h-fit w-full max-w-sm p-1">
            <div class="p-8">
                <div class="text-center">
                    <h1 class="text-title mb-1 text-xl font-semibold">Create an Account</h1>
                    <p class="text-sm">Welcome back! Create an account</p>
                </div>

                <div class="mt-6 grid grid-cols-2 gap-3">
                    <button type="button" class="btn sz-sm variant-outlined">
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
                             viewBox="0 0 24 24"
                        >
                            <path fill="currentColor"
                                  d="M3.064 7.51A10 10 0 0 1 12 2c2.695 0 4.959.991 6.69 2.605l-2.867 2.868C14.786 6.482 13.468 5.977 12 5.977c-2.605 0-4.81 1.76-5.595 4.123c-.2.6-.314 1.24-.314 1.9s.114 1.3.314 1.9c.786 2.364 2.99 4.123 5.595 4.123c1.345 0 2.49-.355 3.386-.955a4.6 4.6 0 0 0 1.996-3.018H12v-3.868h9.418c.118.654.182 1.336.182 2.045c0 3.046-1.09 5.61-2.982 7.35C16.964 21.105 14.7 22 12 22A9.996 9.996 0 0 1 2 12c0-1.614.386-3.14 1.064-4.49"></path>
                        </svg
                        >
                        <span class="btn-label">Google</span>
                    </button>
                    <button type="button" class="btn sz-sm variant-outlined">
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
                             viewBox="0 0 24 24">
                            <path fill="currentColor"
                                  d="M11.501 3v8.5h-8.5V3zm0 18h-8.5v-8.5h8.5zm1-18h8.5v8.5h-8.5zm8.5 9.5V21h-8.5v-8.5z"></path>
                        </svg>
                        <span class="btn-label">Microsoft</span>
                    </button>
                </div>

                <hr class="my-8 border-dashed"/>

                <div class="space-y-8">
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="field">
                                <label for="name" class="text-title text-sm">Full name</label>
                                {{ form_widget(registrationForm.name,{'attr':{'class':"input sz-md variant-outlined"}}) }}

                                {#                                <input type="text" required name="name" id="name" class="input sz-md variant-outlined" /> #}
                            </div>
                            {#                            <div class="field"> #}
                            {#                                <label for="lname" class="text-title text-sm">Last name</label> #}
                            {#                                {{ form_widget(registrationForm.email,{'attr':{'class':"input sz-md variant-outlined"}}) }} #}

                            {#                                <input type="text" required name="lname" id="lname" class="input sz-md variant-outlined" /> #}
                            {#                            </div> #}
                        </div>
                        <div class="field">
                            <label for="phone" class="text-title text-sm"> Phone</label>
                            {{ form_widget(registrationForm.phone,{'attr':{'class':"input sz-md variant-outlined"}}) }}

                            {#                            <input type="email" required name="email2" id="email2" class="input sz-md variant-outlined" /> #}
                        </div>
                        <div class="field">
                            <label for="email2" class="text-title text-sm"> Email</label>
                            {{ form_widget(registrationForm.email,{'attr':{'class':"input sz-md variant-outlined"}}) }}

                            {#                            <input type="email" required name="email2" id="email2" class="input sz-md variant-outlined" /> #}
                        </div>


                        <div class="field">
                            <label for="pwd" class="text-title text-sm"> Password</label>
                            {{ form_widget(registrationForm.plainPassword,{'attr':{'class':"input sz-md variant-outlined"}}) }}
                        </div>
                    </div>
                    {{ form_row(registrationForm.agreeTerms) }}

                    <button class="btn variant-primary sz-md w-full">Sign Up</button>
                </div>
            </div>


            <div data-shade="925" class="card variant-soft rounded-[calc(var(--card-radius)-4px)] dark:!bg-[--ui-bg]">
                <p class="text-center text-sm">
                    Already have an account ?
                    <a href="{{ path('app_login') }}" class="link intent-neutral variant-underlined">Login</a>
                </p>
            </div>
            {{ form_end(registrationForm) }}
    </section>

{% endblock %}
